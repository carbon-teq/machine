      "code_hash": "d4a90a81e4ae807cd2423c0d1489544c",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"divergence-curl-explorer\">Divergence &amp; Curl Explorer</h1>\n<span class=\"paragraph\"><strong>The Jacobian Matrix</strong> contains all the information about how a vector field changes.\nBut sometimes we want to summarize that information into single numbers.</span>\n<ul>\n<li><strong>Divergence:</strong> Sum of the diagonal elements (Trace). Measures expansion.</li>\n<li><strong>Curl:</strong> Difference of off-diagonal elements. Measures rotation.</li>\n</ul></span>"
          }
        }
      ],
      "console": []
    },
