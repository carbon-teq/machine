          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"pointing-at-the-data\">Pointing at the Data</h2>\n<span class=\"paragraph\">Once we have our data packed into a solid block, we need a way to point at specific pieces of it. Because tensors are structured, we can slice them exactly like grids.</span></span>"
          }
        }
      ],
      "console": []
