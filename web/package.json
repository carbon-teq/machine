    "fumadocs-ui": "16.6.10",
    "katex": "^0.16.37",
    "lucide-react": "^0.577.0",
    "mafs": "^0.21.0",
    "manim-web": "^0.3.15",
    "next": "16.1.6",
    "pixi.js": "^8.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
